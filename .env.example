ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Official Receita Federal "Perguntas e Respostas" PDF. The URL changes every tax year.
PDF_URL=
TOP_K=8
# Minimum cosine relevance (0-1) for a chunk to be used. Calibrate against your data.
MIN_RELEVANCE=0.84
MAX_QUESTION_CHARS=1000
RATE_LIMIT=10/minute
CORS_ORIGINS=[]
CHUNK_SIZE=2500
CHUNK_OVERLAP=250
